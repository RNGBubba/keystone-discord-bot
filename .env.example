# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Required to actually connect the bot. `pnpm check` does not need it.
DISCORD_TOKEN=

# `full` requests GuildMembers + MessageContent (welcome, scanner, transcripts).
# `minimal` requests only non-privileged intents; `/setup` names the features
# that are disabled. The Developer Portal must enable every intent you request.
INTENT_PROFILE=full

# P1: real Postgres. Without it, settings are process-local and reset on restart.
# The compose file sets this for you.
DATABASE_URL=postgres://keystone:keystone@localhost:5432/keystone

# P1: Redis backs cooldowns and the job queue. Without it, cooldowns are local
# and jobs run inside the bot process.
REDIS_URL=redis://localhost:6379

# Optional. Tracing is off unless enabled or an OTLP endpoint is set.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
QUEUE_NAME=keystone

# P4 AI is opt-in per guild and off by default. Set a server-side key to create
# the provider; without it `/ai status` says "unconfigured" and all AI calls
# refuse safely. Never put this key in the dashboard or a Discord message.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_INPUT_USD_PER_MILLION=0.15
AI_OUTPUT_USD_PER_MILLION=0.60
# Ollama/Qwen3: stop hidden reasoning from consuming the whole output budget.
# Only send this to providers that accept the Ollama `think` field.
AI_DISABLE_THINKING=false

# Development-only test guild. Seeds AI chat in memory and enables `!` prefix
# commands plus bot-authored mention chat for this guild only, so a Discord MCP
# can exercise the real command pipeline. Ignored in production.
# DEV_GUILD_ID=1450130465146142785

# P6 dashboard/API (`pnpm web:start`, default http://localhost:3000).
# The dashboard boots in memory mode without these; /login returns 503 until
# the OAuth pair and DISCORD_TOKEN are set. Create a Discord application OAuth2
# client, add the exact callback below, and request the `identify guilds` scope.
WEB_PORT=3000
# WEB_ORIGIN=http://localhost:3000
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# DISCORD_OAUTH_ISSUER=https://discord.com
# SESSION_SECRET= # required in production: 32 bytes base64/base64url or 64 hex
# Comma-separated Discord user ids for deployment-wide actions. Managing one
# server is not instance ownership; leave empty to keep the owner console shut.
# WEB_OWNER_IDS=
# Sessions re-key their opaque cookie every 15 minutes and logout revokes the
# Discord grant first; the absolute session lifetime stays seven days. A session
# unused for 30 minutes is deleted, and an expired Discord access token is
# refreshed once from a sealed refresh token. Raise the idle window in
# milliseconds if 30 minutes is too short for your operators (minimum 1 minute).
# WEB_SESSION_IDLE_MS=1800000
