{
  "name": "keystone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keystone — an open-source, teach-by-default all-in-one Discord bot.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RNGBubba/keystone-discord-bot.git"
  },
  "homepage": "https://github.com/RNGBubba/keystone-discord-bot#readme",
  "bugs": {
    "url": "https://github.com/RNGBubba/keystone-discord-bot/issues"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/bot/src/index.ts",
    "start": "tsx apps/bot/src/index.ts",
    "worker:dev": "tsx watch apps/worker/src/index.ts",
    "worker:start": "tsx apps/worker/src/index.ts",
    "web:dev": "tsx watch apps/web/src/index.ts",
    "web:start": "tsx apps/web/src/index.ts",
    "build": "tsup",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=memory/machine/test-report.json",
    "test:watch": "vitest",
    "budget": "tsx scripts/budget.ts",
    "audit:claims": "tsx scripts/audit-claims.ts",
    "memory:render": "node memory/tools/render-memory.mjs",
    "memory:render:check": "node memory/tools/render-memory.mjs --check",
    "memory:check": "node memory/tools/memory-check.mjs",
    "audit:intents": "tsx scripts/audit-intents.ts",
    "audit:channels": "tsx scripts/audit-channels.ts",
    "probe:live": "tsx scripts/live-probe.ts",
    "portability": "tsx scripts/portability.ts",
    "commands:sync": "tsx scripts/commands.ts",
    "commands:resync": "tsx scripts/commands.ts --clear",
    "commands:catalog": "tsx scripts/commands-catalog.ts",
    "commands:doctor": "tsx scripts/commands-doctor.ts",
    "benchmark:ai": "tsx scripts/benchmark-ai.ts",
    "pass:end": "node memory/tools/pass-end.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm budget && pnpm audit:claims && pnpm audit:intents && pnpm audit:channels && pnpm memory:check"
  },
  "dependencies": {
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@keystone/config": "workspace:*",
    "@keystone/db": "workspace:*",
    "@keystone/i18n": "workspace:*",
    "@keystone/importer": "workspace:*",
    "@keystone/kernel": "workspace:*",
    "@keystone/module-forms": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
